{
    "family": "blacklist-ms-task",
    "executionRoleArn": "arn:aws:iam::626771561849:role/blacklist-ms-ecs-task-execution-role",
    "networkMode": "awsvpc",
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "256",
    "memory": "512",
    "runtimePlatform": {
        "cpuArchitecture": "X86_64",
        "operatingSystemFamily": "LINUX"
    },
    "containerDefinitions": [
        {
            "name": "blacklist-ms",
            "image": "<IMAGE1_NAME>",
            "essential": true,
            "portMappings": [
                {
                    "name": "blacklist-ms-5000-tcp",
                    "containerPort": 5000,
                    "hostPort": 5000,
                    "protocol": "tcp",
                    "appProtocol": "http"
                }
            ],
            "environment": [
                {
                    "name": "PROXY_FIX_X_FOR",
                    "value": "1"
                }
            ],
            "secrets": [
                {
                    "name": "DATABASE_URL",
                    "valueFrom": "arn:aws:ssm:us-east-2:626771561849:parameter/blacklist-ms/DATABASE_URL"
                },
                {
                    "name": "JWT_SECRET_KEY",
                    "valueFrom": "arn:aws:ssm:us-east-2:626771561849:parameter/blacklist-ms/JWT_SECRET_KEY"
                }
            ],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/blacklist-ms",
                    "awslogs-region": "us-east-2",
                    "awslogs-stream-prefix": "ecs"
                }
            }
        }
    ]
}
