                "type": "text/javascript",
                "exec": [
                  "pm.test('La respuesta tiene un estado documentado', function () {",
                  "  pm.expect([201, 400, 401, 409]).to.include(pm.response.code);",
                  "});",
                  "pm.test('La respuesta es JSON', function () {",
